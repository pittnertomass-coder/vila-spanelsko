---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import BookingModal from '../components/BookingModal.astro';
import BottomNav from '../components/BottomNav.astro';
import { getLang, useTranslations } from '../i18n/utils';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

interface Props {
  title?: string;
}
const { title = t('page.title') } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Montserrat:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Google Tag Manager — ⚠️ Nahraď GTM-XXXXXXX svým GTM ID -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-XXXXXXX');
    </script>
    <!-- End GTM head -->
  </head>
  <body class="bg-primary text-text-main font-body">

    <!-- GTM noscript fallback — hned za <body> -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX"
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    <LanguageSwitcher />
    <BookingModal />
    <slot />
    <BottomNav />

    <!-- WhatsApp chat bubble -->
    <div class="fixed bottom-20 md:bottom-6 right-6 z-50 flex flex-col items-end gap-3">

      <!-- Popup panel -->
      <div id="wa-popup" class="w-72 bg-white rounded-2xl shadow-2xl overflow-hidden" style="display:none;">
        <!-- Header -->
        <div class="bg-[#075E54] px-4 py-3 flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-[#128C7E] flex-shrink-0 flex items-center justify-center text-white font-bold text-sm">R</div>
          <div class="flex-1 min-w-0">
            <p class="text-white font-semibold text-sm leading-tight">Radek</p>
            <div class="flex items-center gap-1.5 mt-0.5">
              <span class="w-1.5 h-1.5 rounded-full bg-green-400 inline-block"></span>
              <p class="text-green-200 text-xs">Online</p>
            </div>
          </div>
          <button id="wa-close" class="text-white/60 hover:text-white transition p-1 flex-shrink-0" aria-label="Zavřít">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-4 h-4">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <!-- Message bubble -->
        <div class="bg-[#E5DDD5] px-4 py-5">
          <div class="bg-white rounded-xl rounded-tl-sm shadow-sm px-4 py-3 max-w-[230px]">
            <p class="font-body text-sm text-gray-700 leading-relaxed">{t('wa.bubble.message')}</p>
            <p class="font-body text-[10px] text-gray-400 text-right mt-1.5">✓✓</p>
          </div>
        </div>
        <!-- CTA -->
        <div class="bg-white px-4 pt-3 pb-4">
          <a
            href={`https://wa.me/420776646111?text=${encodeURIComponent(t('wa.bubble.prefill'))}`}
            target="_blank"
            rel="noopener noreferrer"
            data-gtm-event="click_whatsapp"
            data-gtm-label="chat_bubble"
            class="flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1ebe5d] text-white rounded-xl py-2.5 font-body font-semibold text-sm w-full transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.859L.054 23.446a.75.75 0 0 0 .918.918l5.587-1.479A11.943 11.943 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.712 9.712 0 0 1-4.953-1.354l-.355-.211-3.668.97.984-3.595-.232-.372A9.712 9.712 0 0 1 2.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/>
            </svg>
            {t('wa.bubble.cta')}
          </a>
          <p class="font-body text-xs text-gray-400 text-center mt-2">{t('wa.bubble.hint')}</p>
        </div>
      </div>

      <!-- Toggle button -->
      <button id="wa-toggle"
        class="w-14 h-14 bg-[#25D366] hover:bg-[#1ebe5d] text-white rounded-full shadow-xl flex items-center justify-center transition-all duration-200 hover:scale-110 hover:shadow-2xl"
        aria-label="WhatsApp chat">
        <svg id="wa-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-7 h-7">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.859L.054 23.446a.75.75 0 0 0 .918.918l5.587-1.479A11.943 11.943 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75a9.712 9.712 0 0 1-4.953-1.354l-.355-.211-3.668.97.984-3.595-.232-.372A9.712 9.712 0 0 1 2.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/>
        </svg>
        <svg id="wa-icon-close-btn" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="w-6 h-6" style="display:none;">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>

    </div>

    <!-- GTM dataLayer events — centrální tracking všech kliknutí -->
    <script is:inline>
      document.addEventListener('click', function(e) {
        var el = e.target;
        // Projdi DOM nahoru (pro případ kliknutí na child element)
        while (el && el !== document.body) {

          // Rezervovat / open booking modal
          if (el.hasAttribute && el.hasAttribute('data-open-booking')) {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: 'click_rezervovat',
              event_label: el.getAttribute('data-package') || 'general',
            });
            break;
          }

          // WhatsApp floating button
          if (el.getAttribute && el.getAttribute('data-gtm-event') === 'click_whatsapp') {
            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: 'click_whatsapp',
              event_label: el.getAttribute('data-gtm-label') || '',
            });
            break;
          }

          el = el.parentNode;
        }
      });

      // Odeslání WA formuláře z modálu
      document.addEventListener('submit_whatsapp', function(e) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'submit_whatsapp_form' });
      });

      // Odeslání kontaktního formuláře
      document.addEventListener('submit_contact', function(e) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: 'submit_contact_form' });
      });

      // WA chat bubble toggle
      var waToggle = document.getElementById('wa-toggle');
      var waPopup = document.getElementById('wa-popup');
      var waClose = document.getElementById('wa-close');
      var waIconOpen = document.getElementById('wa-icon-open');
      var waIconCloseBtn = document.getElementById('wa-icon-close-btn');

      if (waToggle && waPopup) {
        waToggle.addEventListener('click', function() {
          var isOpen = waPopup.style.display !== 'none';
          waPopup.style.display = isOpen ? 'none' : 'block';
          if (waIconOpen) waIconOpen.style.display = isOpen ? '' : 'none';
          if (waIconCloseBtn) waIconCloseBtn.style.display = isOpen ? 'none' : '';
        });
        if (waClose) {
          waClose.addEventListener('click', function() {
            waPopup.style.display = 'none';
            if (waIconOpen) waIconOpen.style.display = '';
            if (waIconCloseBtn) waIconCloseBtn.style.display = 'none';
          });
        }
      }
    </script>
  </body>
</html>
