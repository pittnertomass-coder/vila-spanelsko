---
import { getLang, useTranslations } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

// ⚠️ Doplň po registraci na Smoobu: Settings → Booking Tool → Embed Code → Property ID
const SMOOBU_PROPERTY_ID = 'TVOJE_PROPERTY_ID';

const isConfigured = SMOOBU_PROPERTY_ID !== 'TVOJE_PROPERTY_ID';
const smoobuLang = lang === 'cs' ? 'cs' : lang === 'de' ? 'de' : lang === 'es' ? 'es' : 'en';
---

<section id="rezervace" class="bg-stone-50 py-20 px-4">
  <div class="max-w-5xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-12">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-text-main mb-4">
        {t('booking.h2')}
      </h2>
      <p class="font-body text-text-main/55 max-w-2xl mx-auto text-base leading-relaxed">
        {t('booking.subtitle')}
      </p>
    </div>

    <!-- Smoobu Booking Widget -->
    <div class="bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden">

      {isConfigured ? (
        <!-- Live Smoobu widget -->
        <iframe
          src={`https://login.smoobu.com/${smoobuLang}/booking-tool/iframe/${SMOOBU_PROPERTY_ID}`}
          width="100%"
          height="750"
          frameborder="0"
          scrolling="no"
          loading="lazy"
          title="Rezervační systém Smoobu"
          class="w-full block"
        ></iframe>
      ) : (
        <!-- Placeholder – zobrazí se, dokud nevložíš Property ID -->
        <div class="flex flex-col items-center justify-center gap-5 py-24 px-6 text-center">
          <div class="w-16 h-16 rounded-2xl bg-accent/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-8 h-8 text-accent">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
          </div>
          <div>
            <p class="font-heading font-semibold text-text-main text-lg mb-2">Smoobu rezervační widget</p>
            <p class="font-body text-sm text-text-main/50 max-w-sm">
              Po registraci na <strong>Smoobu</strong> vlož své Property ID do souboru
              <code class="bg-stone-100 px-1.5 py-0.5 rounded text-xs">BookingPlaceholder.astro</code>
              a widget se zde automaticky zobrazí.
            </p>
          </div>
          <div class="bg-stone-50 border border-stone-200 rounded-xl px-5 py-3 font-mono text-xs text-stone-500">
            Settings → Booking Tool → Embed Code → Property ID
          </div>
        </div>
      )}

    </div>

  </div>
</section>
