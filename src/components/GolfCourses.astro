---
import { getLang, useTranslations } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const courses = [
  {
    id: 'mijasgolf',
    img: '/images/los-lagos-course_result.webp',
    car: '2 min',
    bike: '5 min',
  },
  {
    id: 'lacala',
    img: '/images/caption_result.webp',
    car: '10 min',
    bike: null,
  },
  {
    id: 'calanova',
    img: '/images/vista-panoramica-de-calanova_result.webp',
    car: '15 min',
    bike: null,
  },
];
---

<section id="golf" class="bg-stone-50 py-20 px-4">
  <div class="max-w-6xl mx-auto">

    <div class="text-center mb-14">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-text-main mb-4">
        {t('golf.h2')}
      </h2>
      <p class="font-body font-semibold text-text-main/55 max-w-xl mx-auto text-base leading-relaxed">
        {t('golf.subtitle')}
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
      {courses.map((course) => (
        <button
          class="golf-card group relative rounded-2xl overflow-hidden aspect-[4/3] cursor-pointer text-left shadow-md hover:shadow-xl transition-shadow duration-300 w-full"
          data-id={course.id}
          data-name={t(`exp.${course.id}.name` as any)}
          data-distance={t(`exp.${course.id}.distance` as any)}
          data-tagline={t(`exp.${course.id}.tagline` as any)}
          data-desc={t(`exp.${course.id}.desc` as any)}
          data-img={course.img}
          data-car={course.car}
          data-bike={course.bike ?? ''}
          data-carlabel={t('exp.car')}
          data-bikelabel={t('exp.bike')}
          aria-label={t(`exp.${course.id}.name` as any)}
        >
          <img
            src={course.img}
            alt={t(`exp.${course.id}.name` as any)}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
            loading="lazy"
            onerror="this.style.display='none'"
          />
          <div class="absolute inset-0 bg-gradient-to-br from-green-900/60 to-green-700/40 -z-10"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/25 to-transparent"></div>
          <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

          <div class="absolute bottom-0 left-0 right-0 p-5">
            <p class="font-body text-white/65 text-xs uppercase tracking-widest mb-1">
              {t(`exp.${course.id}.distance` as any)}
            </p>
            <h3 class="font-heading text-white text-xl font-bold leading-tight mb-2">
              {t(`exp.${course.id}.name` as any)}
            </h3>
            <p class="font-body text-white/75 text-xs leading-snug line-clamp-2">
              {t(`exp.${course.id}.tagline` as any)}
            </p>
            <div class="flex gap-2 mt-3 flex-wrap">
              <span class="inline-flex items-center gap-1 bg-white/15 backdrop-blur-sm text-white/90 font-body text-xs px-2.5 py-1 rounded-full">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-3 h-3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
                </svg>
                {course.car} {t('exp.car')}
              </span>
              {course.bike && (
                <span class="inline-flex items-center gap-1 bg-white/15 backdrop-blur-sm text-white/90 font-body text-xs px-2.5 py-1 rounded-full">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-3 h-3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                  </svg>
                  {course.bike} {t('exp.bike')}
                </span>
              )}
            </div>
          </div>
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  const modal    = document.getElementById('exp-modal')!;
  const box      = document.getElementById('exp-box')!;
  const backdrop = document.getElementById('exp-backdrop')!;

  function openModal(card: HTMLElement) {
    const img       = card.dataset.img ?? '';
    const name      = card.dataset.name ?? '';
    const distance  = card.dataset.distance ?? '';
    const tagline   = card.dataset.tagline ?? '';
    const desc      = card.dataset.desc ?? '';
    const car       = card.dataset.car ?? '';
    const bike      = card.dataset.bike ?? '';
    const carLabel  = card.dataset.carlabel ?? '';
    const bikeLabel = card.dataset.bikelabel ?? '';

    (document.getElementById('exp-modal-img') as HTMLImageElement).src = img;
    (document.getElementById('exp-modal-img') as HTMLImageElement).alt = name;
    document.getElementById('exp-modal-name')!.textContent     = name;
    document.getElementById('exp-modal-distance')!.textContent = distance;
    document.getElementById('exp-modal-tagline')!.textContent  = tagline;
    document.getElementById('exp-modal-desc')!.textContent     = desc;

    const transport = document.getElementById('exp-modal-transport')!;
    transport.innerHTML = '';
    const pillClass = 'inline-flex items-center gap-1.5 bg-stone-100 text-text-main font-body text-xs font-medium px-3 py-1.5 rounded-full';

    if (car) {
      transport.innerHTML += `<span class="${pillClass}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 0 1-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 0 0-3.213-9.193 2.056 2.056 0 0 0-1.58-.86H14.25M16.5 18.75h-2.25m0-11.177v-.958c0-.568-.422-1.048-.987-1.106a48.554 48.554 0 0 0-10.026 0 1.106 1.106 0 0 0-.987 1.106v7.635m12-6.677v6.677m0 4.5v-4.5m0 0h-12" />
        </svg>
        ${car} ${carLabel}
      </span>`;
    }
    if (bike) {
      transport.innerHTML += `<span class="${pillClass}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-3.5 h-3.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
        </svg>
        ${bike} ${bikeLabel}
      </span>`;
    }

    modal.classList.remove('opacity-0', 'pointer-events-none');
    box.classList.remove('translate-y-4');
    document.body.style.overflow = 'hidden';
  }

  document.querySelectorAll<HTMLElement>('.golf-card').forEach(card => {
    card.addEventListener('click', () => openModal(card));
  });

  if (!backdrop.dataset.listenerAttached) {
    backdrop.dataset.listenerAttached = 'true';
    backdrop.addEventListener('click', () => {
      modal.classList.add('opacity-0', 'pointer-events-none');
      box.classList.add('translate-y-4');
      document.body.style.overflow = '';
    });
  }
</script>
