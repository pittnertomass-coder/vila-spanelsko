---
import { getLang, useTranslations } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const rows = [
  { label: t('packages.row.accommodation'), essential: t('packages.accommodation'), explorer: t('packages.accommodation'), royal: t('packages.accommodation') },
  { label: t('packages.row.amenities'),     essential: t('packages.amenities.val'), explorer: t('packages.amenities.val'), royal: t('packages.amenities.val') },
  { label: t('packages.row.mobility'),      essential: t('packages.mobility.none'), explorer: t('packages.mobility.car'), royal: t('packages.mobility.carplus') },
  { label: t('packages.row.service'),       essential: t('packages.service.standard'), explorer: t('packages.service.standard'), royal: t('packages.service.early') },
  { label: t('packages.row.welcome'),       essential: t('packages.welcome.essential'), explorer: t('packages.welcome.explorer'), royal: t('packages.welcome.royal') },
  { label: t('packages.row.extra'),         essential: t('packages.extra.none'), explorer: t('packages.extra.none'), royal: t('packages.extra.royal') },
];

const packages = [
  {
    id: 'essential',
    name: t('packages.essential'),
    sub: t('packages.essential.sub'),
    price: t('packages.price.essential'),
    popular: false,
    dark: false,
    values: rows.map(r => r.essential),
    ctaData: `${t('packages.essential')} — ${t('packages.price.essential')} ${t('packages.per.week')}`,
  },
  {
    id: 'explorer',
    name: t('packages.explorer'),
    sub: t('packages.explorer.sub'),
    price: t('packages.price.explorer'),
    popular: true,
    dark: false,
    values: rows.map(r => r.explorer),
    ctaData: `${t('packages.explorer')} — ${t('packages.price.explorer')} ${t('packages.per.week')}`,
  },
  {
    id: 'royal',
    name: t('packages.royal'),
    sub: t('packages.royal.sub'),
    price: t('packages.price.royal'),
    popular: false,
    dark: true,
    values: rows.map(r => r.royal),
    ctaData: `${t('packages.royal')} — ${t('packages.price.royal')} ${t('packages.per.week')}`,
  },
];
---

<section id="balicky" class="bg-stone-50 py-20 px-4">
  <div class="max-w-2xl mx-auto">

    <div class="text-center mb-10">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-text-main mb-4">
        {t('packages.h2')}
      </h2>
      <p class="font-body font-semibold text-text-main/60 max-w-xl mx-auto text-base leading-relaxed">
        {t('packages.subtitle')}
      </p>
    </div>

    <div class="space-y-3">
      {packages.map((pkg) => (
        <div
          class:list={[
            'pkg-card rounded-2xl overflow-hidden shadow-sm border transition-all duration-300',
            pkg.dark ? 'bg-text-main border-text-main' : pkg.popular ? 'bg-white border-accent border-2' : 'bg-white border-stone-200',
          ]}
        >
          <!-- Header – vždy viditelný, kliknutím rozbalí -->
          <button
            class="pkg-toggle w-full flex items-center justify-between px-6 py-5 text-left"
            aria-expanded="false"
          >
            <div class="flex items-center gap-4">
              <div>
                {pkg.popular && (
                  <span class="inline-block bg-accent text-white font-body text-[10px] font-bold tracking-widest uppercase px-3 py-0.5 rounded-full mb-1">
                    {t('packages.popular')}
                  </span>
                )}
                <p class:list={['font-body text-xs font-bold tracking-widest uppercase mb-0.5', pkg.dark ? 'text-white/40' : 'text-text-main/40']}>
                  {pkg.sub}
                </p>
                <h3 class:list={['font-heading text-xl font-bold', pkg.dark ? 'text-white' : 'text-text-main']}>
                  {pkg.name}
                </h3>
              </div>
            </div>
            <div class="flex items-center gap-4 flex-shrink-0">
              <div class="text-right">
                <span class:list={['font-heading text-2xl font-bold', pkg.dark ? 'text-white' : pkg.popular ? 'text-accent' : 'text-text-main']}>
                  {pkg.price}
                </span>
                <span class:list={['font-body text-xs block', pkg.dark ? 'text-white/40' : 'text-text-main/40']}>
                  {t('packages.per.week')}
                </span>
              </div>
              <svg
                class:list={['pkg-arrow w-5 h-5 transition-transform duration-300', pkg.dark ? 'text-white/50' : 'text-text-main/40']}
                xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
              </svg>
            </div>
          </button>

          <!-- Detail – skrytý, rozbalí se kliknutím -->
          <div class="pkg-detail hidden px-6 pb-6">
            <div class:list={['border-t pt-5 mb-5 space-y-3', pkg.dark ? 'border-white/10' : 'border-stone-100']}>
              {rows.map((row, i) => (
                <div class="flex justify-between items-start gap-4">
                  <span class:list={['font-body text-xs uppercase tracking-wide flex-shrink-0', pkg.dark ? 'text-white/40' : 'text-text-main/40']}>
                    {row.label}
                  </span>
                  <span class:list={[
                    'font-body text-sm font-medium text-right',
                    pkg.values[i].startsWith('—')
                      ? (pkg.dark ? 'text-white/25' : 'text-text-main/30')
                      : (pkg.dark ? 'text-white/90' : 'text-text-main')
                  ]}>
                    {pkg.values[i]}
                  </span>
                </div>
              ))}
            </div>
            <button
              data-open-booking
              data-package={pkg.ctaData}
              class:list={[
                'w-full font-body text-sm font-semibold tracking-wide rounded-xl py-3 transition-all duration-200',
                pkg.dark
                  ? 'border-2 border-white/25 text-white/80 hover:border-white/60 hover:text-white'
                  : pkg.popular
                    ? 'bg-accent text-white hover:bg-accent/90 shadow-md'
                    : 'border-2 border-text-main/20 text-text-main/70 hover:border-text-main/50 hover:text-text-main'
              ]}
            >
              {t('packages.cta')}
            </button>
          </div>
        </div>
      ))}
    </div>

    <p class="font-body text-xs text-text-main/40 text-center mt-8 max-w-xl mx-auto">
      {t('packages.note')}
    </p>

  </div>
</section>

<script>
  document.querySelectorAll('.pkg-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.pkg-card')!;
      const detail = card.querySelector('.pkg-detail')!;
      const arrow = btn.querySelector('.pkg-arrow')!;
      const isOpen = !detail.classList.contains('hidden');

      // Zavři všechny ostatní
      document.querySelectorAll('.pkg-card').forEach((c) => {
        c.querySelector('.pkg-detail')!.classList.add('hidden');
        c.querySelector('.pkg-arrow')!.classList.remove('rotate-180');
        c.querySelector('.pkg-toggle')!.setAttribute('aria-expanded', 'false');
      });

      if (!isOpen) {
        detail.classList.remove('hidden');
        arrow.classList.add('rotate-180');
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
