---
import { getLang, useTranslations } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);

const items = [
  {
    href: '#top',
    label: lang === 'de' ? 'Übersicht' : lang === 'en' ? 'Home' : lang === 'es' ? 'Inicio' : 'Přehled',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955a1.126 1.126 0 0 1 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>`,
  },
  {
    href: '#galerie',
    label: lang === 'de' ? 'Fotos' : lang === 'en' ? 'Gallery' : lang === 'es' ? 'Galería' : 'Galerie',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909m-18 3.75h16.5a1.5 1.5 0 0 0 1.5-1.5V6a1.5 1.5 0 0 0-1.5-1.5H3.75A1.5 1.5 0 0 0 2.25 6v12a1.5 1.5 0 0 0 1.5 1.5Zm10.5-11.25h.008v.008h-.008V8.25Zm.375 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z" /></svg>`,
  },
  {
    href: '#rezervace',
    label: lang === 'de' ? 'Buchen' : lang === 'en' ? 'Book' : lang === 'es' ? 'Reservar' : 'Rezervace',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" /></svg>`,
  },
  {
    href: '#golf',
    label: 'Golf',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5" /></svg>`,
  },
  {
    href: '#balicky',
    label: lang === 'de' ? 'Pakete' : lang === 'en' ? 'Packages' : lang === 'es' ? 'Paquetes' : 'Balíčky',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z" /></svg>`,
  },
];
---

<nav class="md:hidden fixed bottom-0 left-0 right-0 z-40">
  <div class="bg-white border-t border-stone-200 shadow-[0_-2px_16px_rgba(0,0,0,0.10)]">
    <div class="flex items-stretch">
      {items.map((item) => (
        <a
          href={item.href}
          class="flex-1 flex flex-col items-center justify-center gap-1 py-3 text-text-main/40 hover:text-accent active:text-accent transition-colors duration-150"
        >
          <span set:html={item.icon} />
          <span class="font-body text-[9px] font-bold tracking-wide uppercase leading-none">
            {item.label}
          </span>
        </a>
      ))}
    </div>
    <!-- Safe area pro telefony s home indikátorem -->
    <div class="h-safe-area-inset-bottom"></div>
  </div>
</nav>

<div class="md:hidden h-16"></div>
