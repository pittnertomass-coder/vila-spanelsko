---
import { getLang, useTranslations } from '../i18n/utils';
import WeatherWidget from './WeatherWidget.astro';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="bg-white py-24 px-6">
  <div class="max-w-5xl mx-auto">

    <div class="text-center mb-12">
      <div class="flex items-center justify-center gap-3 mb-8">
        <div class="h-px w-12 bg-accent"></div>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-accent">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
        </svg>
        <div class="h-px w-12 bg-accent"></div>
      </div>
      <h2 class="font-heading font-semibold text-3xl md:text-4xl text-text-main mb-5 tracking-wide">
        {t('location.h2')}
      </h2>
      <p class="font-body font-semibold text-base md:text-lg text-text-main/75 leading-relaxed max-w-2xl mx-auto">
        {t('location.subtitle')}
      </p>
    </div>

    <div class="rounded-2xl overflow-hidden shadow-lg border border-text-main/10 h-80 md:h-[440px] mb-8">
      <iframe
        src="https://maps.google.com/maps?q=Avenida+de+los+Ingenieros,+Riviera+del+Sol,+Mijas,+Malaga&hl=cs&z=15&output=embed&iwloc=near"
        width="100%"
        height="100%"
        frameborder="0"
        loading="lazy"
        title="Poloha vily Casa de la Palma"
        aria-label="Mapa polohy vily"
      ></iframe>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">

      <div class="bg-primary rounded-xl p-5 flex flex-col gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-accent">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 17c1 .667 2 1 3 1s2-.333 3-1 2-1 3-1 2 .333 3 1 2 1 3 1M3 13c1 .667 2 1 3 1s2-.333 3-1 2-1 3-1 2 .333 3 1 2 1 3 1" />
        </svg>
        <div>
          <p class="font-body text-xs text-accent font-semibold uppercase tracking-wider mb-1">{t('location.beach.label')}</p>
          <p class="font-heading font-semibold text-text-main text-sm leading-snug">Max Beach / Riviera Beach</p>
          <p class="font-body text-xs text-text-main/55 mt-1">{t('location.beach.detail')}</p>
        </div>
      </div>

      <div class="bg-primary rounded-xl p-5 flex flex-col gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-accent">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.954-7.123A60.114 60.114 0 0 0 9.019 2.926a59.122 59.122 0 0 0-4.5.975L7.5 14.25Z" />
        </svg>
        <div>
          <p class="font-body text-xs text-accent font-semibold uppercase tracking-wider mb-1">{t('location.market.label')}</p>
          <p class="font-heading font-semibold text-text-main text-sm leading-snug">SuperCor / Mas</p>
          <p class="font-body text-xs text-text-main/55 mt-1">{t('location.market.detail')}</p>
        </div>
      </div>

      <div class="bg-primary rounded-xl p-5 flex flex-col gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-accent">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
        </svg>
        <div>
          <p class="font-body text-xs text-accent font-semibold uppercase tracking-wider mb-1">{t('location.airport.label')}</p>
          <p class="font-heading font-semibold text-text-main text-sm leading-snug">Aeropuerto de Málaga</p>
          <p class="font-body text-xs text-text-main/55 mt-1">{t('location.airport.detail')}</p>
        </div>
      </div>

      <div class="bg-primary rounded-xl p-5 flex flex-col gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-7 h-7 text-accent">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 3v1.5M3 21v-6m0 0 2.77-.693a9 9 0 0 1 6.208.682l.108.054a9 9 0 0 0 6.086.71l3.114-.732a48.524 48.524 0 0 1-.005-10.499l-3.11.732a9 9 0 0 1-6.085-.711l-.108-.054a9 9 0 0 0-6.208-.682L3 4.5M3 15V4.5" />
        </svg>
        <div>
          <p class="font-body text-xs text-accent font-semibold uppercase tracking-wider mb-1">{t('location.golf.label')}</p>
          <p class="font-heading font-semibold text-text-main text-sm leading-snug">Miraflores Golf</p>
          <p class="font-body text-xs text-text-main/55 mt-1">{t('location.golf.detail')}</p>
        </div>
      </div>

    </div>

    <WeatherWidget />

  </div>
</section>
