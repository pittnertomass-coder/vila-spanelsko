---
import { getLang, useTranslations } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---
<section class="bg-primary py-24 px-6">
  <div class="max-w-2xl mx-auto text-center">

    <div class="flex items-center justify-center gap-3 mb-8">
      <div class="h-px w-12 bg-accent"></div>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="w-5 h-5 text-accent">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3c-1.5 3-4 5-7 6 0 5 3 9 7 11 4-2 7-6 7-11-3-1-5.5-3-7-6Z" />
      </svg>
      <div class="h-px w-12 bg-accent"></div>
    </div>

    <h2 class="font-heading font-semibold text-3xl md:text-4xl text-text-main mb-8 tracking-wide">
      {t('about.h2')}
    </h2>

    <p class="font-body font-light text-base md:text-lg text-text-main/90 leading-relaxed max-w-2xl mx-auto">
      {t('about.text')}
    </p>

  </div>
</section>
