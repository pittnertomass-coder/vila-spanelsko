---
import { getLang, useTranslations } from '../i18n/utils';
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<section class="relative h-screen flex flex-col overflow-hidden">

  <img
    src="/images/hero.webp"
    alt="Casa de la Palma"
    class="absolute inset-0 w-full h-full object-cover"
  />

  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, rgba(0,0,0,0.20) 0%, rgba(0,0,0,0.04) 45%, rgba(0,0,0,0.04) 58%, rgba(0,0,0,0.32) 100%);"
  ></div>

  <!-- Logo – vlevo nahoře -->
  <div class="relative z-20 px-6 pt-7">
    <img
      src="/images/logo-hlavni.webp"
      alt="Casa de la Palma"
      class="h-20 md:h-28 w-auto object-contain"
      style="filter: drop-shadow(0 4px 16px rgba(0,0,0,0.55)) drop-shadow(0 1px 4px rgba(0,0,0,0.4));"
    />
  </div>

  <!-- Hlavní obsah -->
  <div class="relative z-10 flex-1 flex flex-col items-center justify-center text-center text-white px-6 max-w-4xl mx-auto w-full">

    <h1
      class="font-heading font-bold text-4xl md:text-8xl leading-tight mb-8 md:mb-10"
      style="text-shadow: 0 2px 28px rgba(0,0,0,0.98), 0 1px 6px rgba(0,0,0,0.85), 0 0 80px rgba(0,0,0,0.45);"
    >
      {t('hero.h1')}
    </h1>

    <p
      class="font-body font-light text-xl md:text-3xl mb-20 md:mb-24 max-w-2xl"
      style="text-shadow: 0 2px 8px rgba(0,0,0,0.55), 0 1px 3px rgba(0,0,0,0.35);"
    >
      {t('hero.subtitle')}
    </p>

    <!-- Badges – jen desktop (sm+) -->
    <a
      href="#rezervace"
      class="hidden sm:grid sm:grid-cols-4 gap-3 w-full max-w-2xl group"
      aria-label={t('hero.cta')}
    >
      <div class="flex flex-col items-center justify-between h-40 bg-white/15 backdrop-blur-sm group-hover:bg-white/25 transition-colors rounded-xl px-4 py-5 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-white">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
        </svg>
        <span class="font-body text-base font-semibold">{t('hero.badge.guests')}</span>
        <span class="font-body text-sm text-white/60">{t('hero.badge.guests.label')}</span>
      </div>
      <div class="flex flex-col items-center justify-between h-40 bg-white/15 backdrop-blur-sm group-hover:bg-white/25 transition-colors rounded-xl px-4 py-5 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-white">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 19.5v-6.75a.75.75 0 0 1 .75-.75h18a.75.75 0 0 1 .75.75V19.5M2.25 12V7.5A2.25 2.25 0 0 1 4.5 5.25H8.25a2.25 2.25 0 0 1 2.25 2.25V12m3 0V7.5a2.25 2.25 0 0 1 2.25-2.25h3.75A2.25 2.25 0 0 1 21.75 7.5V12" />
        </svg>
        <span class="font-body text-base font-semibold">{t('hero.badge.rooms')}</span>
        <span class="font-body text-sm text-white/60">{t('hero.badge.rooms.label')}</span>
      </div>
      <div class="flex flex-col items-center justify-between h-40 bg-white/15 backdrop-blur-sm group-hover:bg-white/25 transition-colors rounded-xl px-4 py-5 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-white">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
        </svg>
        <span class="font-body text-base font-semibold">{t('hero.badge.location')}</span>
        <span class="font-body text-sm text-white/60">{t('hero.badge.location.label')}</span>
      </div>
      <div class="flex flex-col items-center justify-between h-40 bg-white/15 backdrop-blur-sm group-hover:bg-white/25 transition-colors rounded-xl px-4 py-5 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-white">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 17c1 .667 2 1 3 1s2-.333 3-1 2-1 3-1 2 .333 3 1 2 1 3 1M3 13c1 .667 2 1 3 1s2-.333 3-1 2-1 3-1 2 .333 3 1 2 1 3 1" />
        </svg>
        <span class="font-body text-base font-semibold">{t('hero.badge.pool')}</span>
        <span class="font-body text-sm text-white/60">{t('hero.badge.pool.label')}</span>
      </div>
    </a>
  </div>

  <!-- CTA dole -->
  <div class="relative z-10 flex justify-center pb-8 md:pb-12">
    <button
      data-open-booking
      class="bg-accent text-white font-body font-semibold text-base md:text-lg px-8 md:px-10 py-3.5 md:py-4 rounded-xl shadow-lg hover:bg-accent/90 transition-colors duration-200 whitespace-nowrap"
    >
      {t('hero.cta')}
    </button>
  </div>

</section>

<!-- Badges pod Hero – POUZE mobil -->
<div class="sm:hidden bg-text-main px-4 py-6">
  <div class="grid grid-cols-2 gap-3 max-w-sm mx-auto">
    <div class="flex flex-col items-center justify-between h-32 bg-white/10 rounded-xl px-3 py-4 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-white">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
      </svg>
      <p class="text-white font-body text-sm font-semibold">{t('hero.badge.guests')}</p>
      <p class="text-white/50 font-body text-xs">{t('hero.badge.guests.label')}</p>
    </div>
    <div class="flex flex-col items-center justify-between h-32 bg-white/10 rounded-xl px-3 py-4 text-center">
