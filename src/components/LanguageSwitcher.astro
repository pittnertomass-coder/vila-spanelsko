---
import { languages } from '../i18n/ui';

const currentLang = Astro.currentLocale ?? 'cs';

const links = [
  { code: 'cs', href: '/' },
  { code: 'en', href: '/en/' },
  { code: 'de', href: '/de/' },
  { code: 'es', href: '/es/' },
];
---

<div translate="no" class="fixed top-5 right-5 z-50 flex items-center gap-1 bg-black/50 backdrop-blur-sm rounded-full px-3 py-2 shadow-xl border border-white/15">
  {links.map(({ code, href }) => (
    <a
      href={href}
      class:list={[
        'font-body text-sm font-bold px-3.5 py-1.5 rounded-full transition-all duration-200 tracking-widest',
        currentLang === code
          ? 'bg-accent text-white shadow-md'
          : 'text-white/80 hover:text-white hover:bg-white/20'
      ]}
      aria-label={languages[code as keyof typeof languages]}
      aria-current={currentLang === code ? 'page' : undefined}
    >
      {code.toUpperCase()}
    </a>
  ))}
</div>
